# .env にコピーし、データベース起動前にパスワードを変更してください。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=jp_doc_agent
POSTGRES_USER=jp_doc_agent
POSTGRES_PASSWORD=replace_with_a_random_password

# ベクトル化・検索・回答生成に必要です。取り込み・分割・保存件数の確認には不要です。
OPENAI_API_KEY=

# 回答生成。Responses API の構造化出力に対応するモデルを指定します。
OPENAI_ANSWER_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_ANSWER_MAX_OUTPUT_TOKENS=2048
